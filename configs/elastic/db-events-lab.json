{
  "settings": {"number_of_shards": 1, "number_of_replicas": 0},
  "mappings": {
    "dynamic": "strict",
    "_meta": {"owner": "dbic", "schema_version": 1, "environment": "lab"},
    "properties": {
      "@timestamp": {"type": "date"},
      "db": {"properties": {"type": {"type": "keyword"}, "instance_id": {"type": "keyword"}}},
      "event": {"properties": {"category": {"type": "keyword"}, "code": {"type": "keyword"}}},
      "message": {"type": "text", "index": false}
    }
  }
}
