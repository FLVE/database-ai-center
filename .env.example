DBIC_ENV=lab
DBIC_PG_PASSWORD=
DBIC_API_TOKEN=
MYSQL_ROOT_PASSWORD=
MYSQL_DIAG_PASSWORD=
# Optional Redis: scripts/init_redis_lab.py generates private lab ACL/env files under dist/.
DBIC_REDIS_ENABLED=false
DBIC_REDIS_DIAG_PASSWORD=
DBIC_REDIS_AUDIT_DIR=
# Optional historical sources; configure actual local ports before enabling.
DBIC_SEARCH_BACKEND=null
DBIC_METRICS_BACKEND=null
DBIC_ELASTIC_URL=
DBIC_ELASTIC_API_KEY=
DBIC_PROMETHEUS_URL=
DBIC_PROMETHEUS_TOKEN=
DBIC_PROMETHEUS_INSTANCE_LABEL=instance
DBIC_PROMETHEUS_INSTANCE_VALUE=
# Optional trusted CA path inside the API container (TLS verification stays enabled).
DBIC_HISTORY_CA_FILE=
# Optional Agent; only sanitized evidence metadata is sent. Base URL ends in /v1.
DBIC_AGENT_BACKEND=null
DBIC_LLM_PROVIDER=openai_compatible
DBIC_LLM_BASE_URL=
DBIC_LLM_API_KEY=
DBIC_LLM_MODEL=
DBIC_LLM_TIMEOUT_SECONDS=8
# Authenticated Streamable HTTP at /mcp/; same local Bearer token as REST.
DBIC_MCP_ENABLED=false
# Local host execution only: set a full DSN for an isolated PostgreSQL lab.
# Compose constructs its own URL from DBIC_PG_PASSWORD safely.
# DBIC_DATABASE_URL=postgresql+psycopg://dbic:URL_ENCODED_PASSWORD@127.0.0.1:5432/dbic
DBIC_MONGODB_ENABLED=false
DBIC_POSTGRESQL_ENABLED=false
DBIC_DORIS_ENABLED=false
DBIC_DORIS_DIAG_PASSWORD=
DBIC_POSTGRESQL_DIAG_PASSWORD=
DBIC_MONGODB_DIAG_PASSWORD=
